# Shared / fallback env. Copy to .env at the repo root if you want one file
# for the backend (AppModule also reads ../.env from backend/).
# Docker Compose also reads this file for service environment defaults.

# Backend
PORT=3001
JWT_SECRET=vita-forge-secret-key-change-in-production
# Include the Docker frontend (8080) and Vite dev (5173) origins.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
# Leave empty for in-memory store; set for Postgres (local or compose --profile db).
DATABASE_URL=
ANTHROPIC_API_KEY=

# Frontend (Vite only reads frontend/.env — keep a copy there too)
VITE_APP_NAME=VitaForge Resume Generator
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_URL=http://localhost:3001/api
